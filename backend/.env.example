# Porta HTTP da API (o proxy do frontend aponta para 3000)
PORT=3000
# Origem permitida pelo CORS (ng serve)
CORS_ORIGIN=http://localhost:4200
# Caminho do banco SQLite, relativo à pasta backend/ (ou :memory:)
DB_PATH=data/estoque.db
# Popular dados de exemplo quando o banco estiver vazio
SEED=true
